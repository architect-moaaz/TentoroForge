{
  "name": "Document Intelligence",
  "pages": [
    {
      "name": "UploadPage",
      "type": "form",
      "route": "/upload",
      "entity": "Document",
      "fields": [
        {
          "name": "files",
          "label": "Files",
          "required": true,
          "order": 1
        }
      ],
      "submit": {
        "kind": "workflow",
        "target": "ProcessDocumentWorkflow",
        "field_map": {}
      },
      "actions": [],
      "features": [],
      "archetype": "form",
      "description": "Multi-file drag-and-drop dropzone accepting PDF and image files. On submit, dispatches one ProcessDocument workflow per file and navigates to /documents.",
      "density": "sparse"
    },
    {
      "name": "DocumentsListPage",
      "type": "list",
      "route": "/documents",
      "entity": "Document",
      "actions": [],
      "features": [
        "status-pipeline"
      ],
      "archetype": "list",
      "dataSource": {
        "op": "list",
        "entity": "Document"
      },
      "description": "Paginated table of all documents with columns: filename, status (coloured Tag), uploadedAt, processedAt, confidence score. Auto-polls every 5 s while any row has status=processing; stops polling when all rows are terminal. Search bar queries full-text index.",
      "density": "regular"
    },
    {
      "name": "DocumentDetailPage",
      "type": "detail",
      "route": "/documents/[id]",
      "entity": "Document",
      "actions": [],
      "features": [],
      "archetype": "detail",
      "description": "Two-column layout: left pane shows inline PDF embed or image preview via file URL; right pane shows extracted fields as DescriptionList with per-field confidence chips (green \u22650.85, amber 0.60-0.85, red <0.60). Collapsible panel below right pane shows raw OCR text in monospaced pre block. Header shows status Tag and overall confidence score.",
      "density": "regular"
    },
    {
      "name": "SearchPage",
      "type": "list",
      "route": "/search",
      "entity": "Document",
      "actions": [],
      "features": [],
      "archetype": "list",
      "dataSource": {
        "op": "list",
        "entity": "Document"
      },
      "description": "Full-text search across ocrText tsvector and extractedFields GIN index. Results show filename, matched snippet, status, and key extracted field values. Search input queries GET /api/search?q=.",
      "kind": "search",
      "density": "regular"
    },
    {
      "name": "DashboardPage",
      "type": "dashboard",
      "route": "/",
      "entity": null,
      "actions": [],
      "widgets": [
        {
          "type": "stat",
          "entity": "Document",
          "title": "Total Documents",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "stat",
          "entity": "Document",
          "title": "Processing",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "stat",
          "entity": "Document",
          "title": "Complete",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "stat",
          "entity": "Document",
          "title": "Failed",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "table",
          "entity": "Document",
          "title": "Recent Uploads",
          "limit": 10,
          "columns": [
            "originalFilename",
            "status",
            "uploadedAt",
            "confidenceScore"
          ]
        }
      ],
      "features": [],
      "archetype": "dashboard",
      "description": "KPI tiles: total documents, processing count, complete count, failed count. Recent uploads table (last 10). Link to upload and search.",
      "entity_summary": [
        "User",
        "Document",
        "ProcessDocumentJob"
      ],
      "density": "regular"
    },
    {
      "name": "Login",
      "type": "auth",
      "route": "/login",
      "entity": null,
      "actions": [],
      "features": [],
      "archetype": "list",
      "density": "sparse"
    },
    {
      "id": "admins-list",
      "name": "admins",
      "type": "list",
      "route": "/admins",
      "entity": "User",
      "filter": {
        "role": "admin"
      },
      "source": "actor_onboarding",
      "visibleTo": [
        "admin"
      ],
      "description": "Directory of admins in the app.",
      "actions": [],
      "archetype": "list",
      "features": [],
      "density": "regular"
    }
  ],
  "actors": [
    {
      "name": "admin",
      "role": "admin",
      "access": "authenticated"
    }
  ],
  "domain": "CRM & Sales",
  "entities": {
    "User": {
      "table": "users",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "email",
          "type": "varchar"
        },
        {
          "name": "name",
          "type": "varchar"
        },
        {
          "name": "role",
          "type": "varchar",
          "semantic": {
            "control": "Select",
            "enum_values": [
              "admin"
            ]
          },
          "enum_values": [
            "admin"
          ]
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/users.ts"
    },
    "Document": {
      "table": "documents",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "originalFilename",
          "type": "varchar"
        },
        {
          "name": "filePath",
          "type": "varchar"
        },
        {
          "name": "fileMimeType",
          "type": "varchar"
        },
        {
          "name": "status",
          "type": "varchar",
          "semantic": {
            "control": "Select",
            "enum_values": [
              "queued",
              "processing",
              "complete",
              "failed"
            ]
          },
          "enum_values": [
            "queued",
            "processing",
            "complete",
            "failed"
          ]
        },
        {
          "name": "uploadedById",
          "type": "uuid"
        },
        {
          "name": "uploadedAt",
          "type": "timestamp"
        },
        {
          "name": "processedAt",
          "type": "timestamp"
        },
        {
          "name": "ocrText",
          "type": "text"
        },
        {
          "name": "extractedFields",
          "type": "jsonb"
        },
        {
          "name": "confidenceScore",
          "type": "integer"
        },
        {
          "name": "errorMessage",
          "type": "text"
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/documents.ts",
      "used_by": [
        "ProcessDocumentJob"
      ],
      "depends_on": [
        "User"
      ]
    },
    "UploadedBy": {
      "name": "UploadedBy",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "name",
          "type": "varchar",
          "not_null": true
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "synthesized": true
    },
    "ProcessDocumentJob": {
      "table": "process_document_jobs",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "documentId",
          "type": "uuid"
        },
        {
          "name": "queuedAt",
          "type": "timestamp"
        },
        {
          "name": "startedAt",
          "type": "timestamp"
        },
        {
          "name": "completedAt",
          "type": "timestamp"
        },
        {
          "name": "currentStep",
          "type": "varchar"
        },
        {
          "name": "attempts",
          "type": "integer"
        },
        {
          "name": "errorMessage",
          "type": "text"
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/process_document_jobs.ts",
      "depends_on": [
        "Document"
      ]
    }
  },
  "register": "linear",
  "authGated": true,
  "relations": [
    {
      "to": "User",
      "from": "Document",
      "foreignKey": "uploadedById"
    },
    {
      "to": "Document",
      "from": "ProcessDocumentJob",
      "foreignKey": "documentId"
    }
  ],
  "workflows": [
    {
      "name": "ProcessDocumentWorkflow",
      "steps": [
        {
          "id": "insert_document",
          "next": "insert_job",
          "type": "action",
          "config": {
            "table": "documents",
            "fields": [
              "originalFilename",
              "filePath",
              "fileMimeType",
              "status",
              "uploadedById",
              "uploadedAt"
            ],
            "values": {
              "status": "queued",
              "uploadedAt": "{{now}}"
            },
            "actionType": "db_insert"
          }
        },
        {
          "id": "insert_job",
          "next": "mark_processing",
          "type": "action",
          "config": {
            "table": "process_document_jobs",
            "fields": [
              "documentId",
              "queuedAt",
              "currentStep",
              "attempts"
            ],
            "values": {
              "attempts": 0,
              "queuedAt": "{{now}}",
              "documentId": "{{insert_document.id}}",
              "currentStep": "queued"
            },
            "actionType": "db_insert"
          }
        },
        {
          "id": "mark_processing",
          "next": "update_job_step_ocr",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{insert_document.id}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "processing"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "update_job_step_ocr",
          "next": "ocr_sidecar",
          "type": "action",
          "config": {
            "table": "process_document_jobs",
            "where": {
              "documentId": "{{insert_document.id}}"
            },
            "fields": [
              "currentStep",
              "startedAt"
            ],
            "values": {
              "startedAt": "{{now}}",
              "currentStep": "ocr"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "ocr_sidecar",
          "next": "ocr_success_gate",
          "type": "action",
          "config": {
            "url": "{{env.PADDLEOCR_SIDECAR_URL}}/ocr",
            "body": {
              "filePath": "{{insert_document.filePath}}"
            },
            "method": "POST",
            "outputVar": "ocrResult",
            "actionType": "http_call"
          }
        },
        {
          "id": "ocr_success_gate",
          "type": "exclusive_gateway",
          "config": {
            "condition": "ocrResult.success == true"
          },
          "branches": {
            "true": "update_job_step_ai",
            "false": "mark_failed"
          }
        },
        {
          "id": "update_job_step_ai",
          "next": "ai_extract_fields",
          "type": "action",
          "config": {
            "table": "process_document_jobs",
            "where": {
              "documentId": "{{insert_document.id}}"
            },
            "fields": [
              "currentStep"
            ],
            "values": {
              "currentStep": "ai_extraction"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "ai_extract_fields",
          "next": "persist_results",
          "type": "action",
          "config": {
            "input": "{{ocrResult.text}}",
            "fields": [
              "extractedFields",
              "confidenceScore"
            ],
            "prompt": "Extract all structured fields from this document text as a flat key-value JSON object. Also return an overall confidence score between 0 and 1.",
            "outputVar": "aiResult",
            "actionType": "ai_extract"
          }
        },
        {
          "id": "persist_results",
          "next": "finalize_job",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{insert_document.id}}"
            },
            "fields": [
              "status",
              "ocrText",
              "extractedFields",
              "confidenceScore",
              "processedAt"
            ],
            "values": {
              "status": "complete",
              "ocrText": "{{ocrResult.text}}",
              "processedAt": "{{now}}",
              "confidenceScore": "{{aiResult.confidenceScore}}",
              "extractedFields": "{{aiResult.extractedFields}}"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "finalize_job",
          "next": "notify_complete",
          "type": "action",
          "config": {
            "table": "process_document_jobs",
            "where": {
              "documentId": "{{insert_document.id}}"
            },
            "fields": [
              "currentStep",
              "completedAt"
            ],
            "values": {
              "completedAt": "{{now}}",
              "currentStep": "complete"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "notify_complete",
          "next": "end",
          "type": "action",
          "config": {
            "message": "Document {{insert_document.originalFilename}} processed successfully.",
            "actionType": "send_notification",
            "recipientRole": "admin"
          }
        },
        {
          "id": "mark_failed",
          "next": "fail_job",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{insert_document.id}}"
            },
            "fields": [
              "status",
              "errorMessage"
            ],
            "values": {
              "status": "failed",
              "errorMessage": "{{ocrResult.error}}"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "fail_job",
          "next": "notify_failed",
          "type": "action",
          "config": {
            "table": "process_document_jobs",
            "where": {
              "documentId": "{{insert_document.id}}"
            },
            "fields": [
              "currentStep",
              "errorMessage",
              "completedAt"
            ],
            "values": {
              "completedAt": "{{now}}",
              "currentStep": "failed",
              "errorMessage": "{{ocrResult.error}}"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "notify_failed",
          "next": "end",
          "type": "action",
          "config": {
            "message": "Document processing failed for {{insert_document.originalFilename}}: {{ocrResult.error}}",
            "actionType": "send_notification",
            "recipientRole": "admin"
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "inputs": [
        {
          "name": "files",
          "type": "jsonb",
          "source": {
            "kind": "form_field",
            "field": "files"
          },
          "required": true
        },
        {
          "name": "uploadedById",
          "type": "uuid",
          "source": {
            "kind": "auth",
            "claim": "user.id"
          },
          "required": true
        }
      ],
      "source": {
        "kind": "form",
        "page": "/upload"
      },
      "trigger": "form_submit on UploadPage",
      "description": "Insert Document row, dispatch OCR via PaddleOCR sidecar, run AI extraction, persist results."
    },
    {
      "name": "ReprocessDocumentWorkflow",
      "steps": [
        {
          "id": "reset_document",
          "next": "insert_reprocess_job",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status",
              "ocrText",
              "extractedFields",
              "confidenceScore",
              "errorMessage",
              "processedAt"
            ],
            "values": {
              "status": "queued",
              "ocrText": null,
              "processedAt": null,
              "errorMessage": null,
              "confidenceScore": null,
              "extractedFields": null
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "insert_reprocess_job",
          "next": "fetch_document",
          "type": "action",
          "config": {
            "table": "process_document_jobs",
            "fields": [
              "documentId",
              "queuedAt",
              "currentStep",
              "attempts"
            ],
            "values": {
              "attempts": 0,
              "queuedAt": "{{now}}",
              "documentId": "{{documentId}}",
              "currentStep": "queued"
            },
            "actionType": "db_insert"
          }
        },
        {
          "id": "fetch_document",
          "next": "mark_reprocessing",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "outputVar": "doc",
            "actionType": "db_query"
          }
        },
        {
          "id": "mark_reprocessing",
          "next": "ocr_reprocess",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "processing"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "ocr_reprocess",
          "next": "reprocess_gate",
          "type": "action",
          "config": {
            "url": "{{env.PADDLEOCR_SIDECAR_URL}}/ocr",
            "body": {
              "filePath": "{{doc.filePath}}"
            },
            "method": "POST",
            "outputVar": "ocrResult",
            "actionType": "http_call"
          }
        },
        {
          "id": "reprocess_gate",
          "type": "exclusive_gateway",
          "config": {
            "condition": "ocrResult.success == true"
          },
          "branches": {
            "true": "ai_reextract",
            "false": "reprocess_fail"
          }
        },
        {
          "id": "ai_reextract",
          "next": "persist_reprocess",
          "type": "action",
          "config": {
            "input": "{{ocrResult.text}}",
            "fields": [
              "extractedFields",
              "confidenceScore"
            ],
            "prompt": "Extract all structured fields from this document text as a flat key-value JSON object. Also return an overall confidence score between 0 and 1.",
            "outputVar": "aiResult",
            "actionType": "ai_extract"
          }
        },
        {
          "id": "persist_reprocess",
          "next": "finalize_reprocess_job",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status",
              "ocrText",
              "extractedFields",
              "confidenceScore",
              "processedAt"
            ],
            "values": {
              "status": "complete",
              "ocrText": "{{ocrResult.text}}",
              "processedAt": "{{now}}",
              "confidenceScore": "{{aiResult.confidenceScore}}",
              "extractedFields": "{{aiResult.extractedFields}}"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "finalize_reprocess_job",
          "next": "notify_reprocess_complete",
          "type": "action",
          "config": {
            "table": "process_document_jobs",
            "where": {
              "documentId": "{{documentId}}"
            },
            "fields": [
              "currentStep",
              "completedAt"
            ],
            "values": {
              "completedAt": "{{now}}",
              "currentStep": "complete"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "notify_reprocess_complete",
          "next": "end",
          "type": "action",
          "config": {
            "message": "Document reprocessed successfully.",
            "actionType": "send_notification",
            "recipientRole": "admin"
          }
        },
        {
          "id": "reprocess_fail",
          "next": "notify_reprocess_failed",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status",
              "errorMessage"
            ],
            "values": {
              "status": "failed",
              "errorMessage": "{{ocrResult.error}}"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "notify_reprocess_failed",
          "next": "end",
          "type": "action",
          "config": {
            "message": "Document reprocessing failed: {{ocrResult.error}}",
            "actionType": "send_notification",
            "recipientRole": "admin"
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "inputs": [
        {
          "name": "documentId",
          "type": "uuid",
          "source": {
            "kind": "route",
            "param": "id"
          },
          "required": true
        },
        {
          "name": "requestedById",
          "type": "uuid",
          "source": {
            "kind": "auth",
            "claim": "user.id"
          },
          "required": true
        }
      ],
      "source": {
        "kind": "button",
        "page": "DocumentDetailPage"
      },
      "trigger": "button on DocumentDetailPage",
      "description": "Reset document status to queued and rerun OCR + AI extraction pipeline."
    }
  ],
  "api_routes": [
    {
      "path": "/api/search",
      "entity": "Document",
      "method": "GET",
      "description": "Full-text search across documents. Queries ocrText tsvector and extractedFields GIN index. Accepts ?q= param. Returns id, originalFilename, snippet, status, confidenceScore, extractedFields."
    },
    {
      "path": "/api/documents",
      "entity": "Document",
      "method": "GET",
      "description": "List documents with pagination and status filter. Supports ?status= filter for poll-based status updates."
    }
  ],
  "assumptions": [
    "Job queue technology assumed to be a simple DB-backed queue (pg-boss pattern) since no external queue was specified \u2014 ProcessDocumentJob table tracks state; the workflow engine dispatches async.",
    "PaddleOCR sidecar exposes HTTP POST /ocr accepting {filePath} and returning {success, text, error} \u2014 downstream code must verify actual sidecar contract.",
    "AI extraction provider assumed to be the platform's built-in ai_extract action (OpenAI-backed) \u2014 prompt engineering may need tuning per document domain.",
    "File storage assumed to be object storage (S3/GCS/local mount) with filePath storing the storage key/path \u2014 inline viewer URL generation uses a signed URL or static serve endpoint.",
    "Document-level confidence score is the mean of per-field confidence scores returned by the AI extraction step \u2014 stored as integer (0-100 scaled) in confidenceScore.",
    "Multi-page PDF rendering uses browser-native <embed> \u2014 page navigation UX deferred to browser controls.",
    "extractedFields JSONB is kept flat (one level deep) to ensure GIN index covers all searchable values.",
    "Auto-poll on /documents stops when all visible rows have status in {complete, failed} \u2014 implemented client-side with a useEffect that clears the interval on terminal state.",
    "File size limit enforced server-side at 50 MB per file to prevent memory exhaustion during OCR preprocessing.",
    "ProcessDocument job is dispatched inside an after-commit hook on the documents insert to avoid the race condition where the job starts before the DB row is visible."
  ],
  "audit_trail": [
    {
      "on": [
        "create",
        "update"
      ],
      "entity": "Document"
    }
  ],
  "data_models": [
    {
      "name": "User",
      "table": "users",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "email",
          "type": "varchar"
        },
        {
          "name": "name",
          "type": "varchar"
        },
        {
          "name": "role",
