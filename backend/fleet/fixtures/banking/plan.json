{
  "name": "Banking Document Intelligence",
  "pages": [
    {
      "name": "DashboardPage",
      "type": "dashboard",
      "route": "/",
      "entity": null,
      "actions": [],
      "widgets": [
        {
          "type": "stat",
          "entity": "Batch",
          "title": "Total Batches",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "stat",
          "entity": "Document",
          "title": "Processed Documents",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "stat",
          "entity": "Document",
          "title": "Pending Documents",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "stat",
          "entity": "Document",
          "title": "Failed Documents",
          "metric": {
            "fn": "count"
          }
        },
        {
          "type": "table",
          "entity": "Batch",
          "title": "Recent Batches",
          "limit": 10,
          "columns": [
            "id",
            "status",
            "documentCount",
            "createdAt"
          ]
        }
      ],
      "features": [
        "status-pipeline"
      ],
      "archetype": "dashboard",
      "description": "KPI tiles: total batches today, documents processed, documents pending, failed documents. Recent batch activity table. Quick upload CTA button.",
      "entity_summary": [
        "Org",
        "User",
        "Batch",
        "Document",
        "ExtractedField",
        "RetentionPolicy"
      ]
    },
    {
      "name": "BatchUploadPage",
      "type": "form",
      "route": "/batches/new",
      "entity": "Batch",
      "fields": [
        {
          "name": "notes",
          "semanticType": "multiline",
          "label": "Batch Notes",
          "required": false,
          "order": 1
        },
        {
          "name": "files",
          "label": "Files (PDF / images)",
          "required": true,
          "order": 2
        }
      ],
      "submit": {
        "kind": "workflow",
        "target": "CreateBatchWorkflow"
      },
      "actions": [],
      "features": [],
      "archetype": "form",
      "description": "Multi-file upload form. Drag-and-drop zone accepts PDF and image files. Notes textarea. On submit, creates Batch record and fans out Document records, dispatching IngestDocumentWorkflow per file."
    },
    {
      "name": "BatchHistoryPage",
      "type": "list",
      "route": "/batches",
      "entity": "Batch",
      "actions": [],
      "features": [
        "status-pipeline"
      ],
      "archetype": "list",
      "dataSource": {
        "op": "list",
        "entity": "Batch"
      },
      "description": "Paginated list of all batches with status badge, document count, uploader, and timestamp. Polls every 5s (setTimeout-recurse) while any batch has status queued|processing. Click row to navigate to batch detail."
    },
    {
      "name": "BatchDetailPage",
      "type": "detail",
      "route": "/batches/[id]",
      "entity": "Batch",
      "actions": [],
      "features": [
        "status-pipeline"
      ],
      "archetype": "detail",
      "dataSource": {
        "op": "list",
        "entity": "Batch"
      },
      "description": "Batch summary header (status, counts, uploader, timestamp). Document list table below showing per-document status, docType, filename, confidence score. Click document row to open document viewer."
    },
    {
      "name": "DocumentViewerPage",
      "type": "detail",
      "route": "/documents/[id]",
      "entity": "Document",
      "actions": [],
      "features": [],
      "archetype": "detail",
      "description": "Side-by-side layout. Left pane: original file rendered via pdf.js (fallback for CSP-restricted environments) with bounding-box overlays for extracted fields (coordinates normalised to displayed dimensions). Right pane: ExtractedField DescriptionList with confidence chips colour-coded (green \u226580, amber 50-79, red <50). Collapsed panel below: raw ocrText in monospace scrollable area. Header shows docType badge, status badge, OCR confidence, page count."
    },
    {
      "name": "SearchPage",
      "type": "list",
      "route": "/search",
      "entity": "Document",
      "actions": [],
      "features": [],
      "archetype": "list",
      "dataSource": {
        "op": "list",
        "entity": "Document"
      },
      "description": "Full-text search bar using websearch_to_tsquery. Searches across Document.ocrTextTsv and ExtractedField.valueTsv with JOIN and ts_rank weighting to deduplicate. Results list shows filename, docType, matched snippet (ts_headline), batch ID, date. Filter sidebar: docType, date range, status, confidence threshold. Click result to open document viewer."
    },
    {
      "name": "RetentionPolicyPage",
      "type": "list",
      "route": "/settings/retention",
      "entity": "RetentionPolicy",
      "actions": [],
      "features": [],
      "archetype": "list",
      "dataSource": {
        "op": "list",
        "entity": "RetentionPolicy"
      },
      "description": "Admin-only list of retention policies per docType. Inline editable retain_years. Add new policy form inline."
    },
    {
      "name": "RetentionPolicyFormPage",
      "type": "form",
      "route": "/settings/retention/new",
      "entity": "RetentionPolicy",
      "fields": [
        {
          "name": "docType",
          "label": "Document Type",
          "required": true,
          "order": 1
        },
        {
          "name": "retainYears",
          "label": "Retain Years",
          "required": true,
          "order": 2
        }
      ],
      "submit": {
        "kind": "data_api",
        "target": "RetentionPolicy"
      },
      "actions": [],
      "features": [],
      "archetype": "form"
    },
    {
      "name": "UserManagementPage",
      "type": "list",
      "route": "/admin/users",
      "entity": "User",
      "actions": [],
      "features": [],
      "archetype": "list",
      "dataSource": {
        "op": "list",
        "entity": "User"
      },
      "description": "Admin-only user list with role badges, email, last login. Invite new user button. Deactivate action per row."
    },
    {
      "name": "AuditLogPage",
      "type": "list",
      "route": "/audit",
      "entity": "Document",
      "actions": [],
      "features": [],
      "archetype": "audit-log",
      "dataSource": {
        "op": "list",
        "entity": "Document"
      },
      "description": "Compliance-only chronological audit log of all document status transitions, field extractions, and batch events. Filter by entity type, date range, user. Export to CSV."
    },
    {
      "name": "AnalyticsPage",
      "type": "dashboard",
      "route": "/analytics",
      "entity": null,
      "actions": [],
      "widgets": [
        {
          "type": "chart",
          "entity": "Document",
          "title": "Documents Processed per Day",
          "groupBy": "createdAt",
          "bucket": "day"
        },
        {
          "type": "chart",
          "entity": "Document",
          "title": "By Document Type",
