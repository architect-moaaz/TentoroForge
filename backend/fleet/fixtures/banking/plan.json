  "domain": "fintech",
  "entities": {
    "Org": {
      "table": "orgs",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "name",
          "type": "varchar"
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/orgs.ts",
      "used_by": [
        "User",
        "Batch",
        "RetentionPolicy"
      ],
      "depends_on": []
    },
    "User": {
      "table": "users",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "orgId",
          "type": "uuid"
        },
        {
          "name": "email",
          "type": "varchar"
        },
        {
          "name": "fullName",
          "type": "varchar"
        },
        {
          "name": "role",
          "type": "varchar",
          "semantic": {
            "control": "Select",
            "enum_values": [
              "archivist",
              "compliance",
              "admin"
            ]
          },
          "enum_values": [
            "archivist",
            "compliance",
            "admin"
          ]
        },
        {
          "name": "lastLoginAt",
          "type": "timestamp"
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        },
        {
          "name": "name",
          "type": "varchar"
        }
      ],
      "schema": "src/db/schema/users.ts",
      "used_by": [
        "Batch"
      ],
      "depends_on": [
        "Org"
      ]
    },
    "Batch": {
      "table": "batches",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "orgId",
          "type": "uuid"
        },
        {
          "name": "uploadedBy",
          "type": "uuid",
          "user_fk_role": "actor"
        },
        {
          "name": "status",
          "type": "varchar",
          "semantic": {
            "control": "Select",
            "enum_values": [
              "queued",
              "processing",
              "complete",
              "failed_partial"
            ]
          },
          "enum_values": [
            "queued",
            "processing",
            "complete",
            "failed_partial"
          ]
        },
        {
          "name": "documentCount",
          "type": "integer"
        },
        {
          "name": "notes",
          "type": "text"
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/batches.ts",
      "used_by": [
        "Document"
      ],
      "depends_on": [
        "Org",
        "User"
      ]
    },
    "Document": {
      "table": "documents",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "batchId",
          "type": "uuid"
        },
        {
          "name": "orgId",
          "type": "uuid"
        },
        {
          "name": "originalFilename",
          "type": "varchar"
        },
        {
          "name": "filePath",
          "type": "varchar"
        },
        {
          "name": "mimeType",
          "type": "varchar"
        },
        {
          "name": "sizeBytes",
          "type": "integer"
        },
        {
          "name": "docType",
          "type": "varchar",
          "semantic": {
            "control": "Select",
            "enum_values": [
              "loan_agreement",
              "identity_document",
              "bank_statement",
              "correspondence",
              "other"
            ]
          },
          "enum_values": [
            "loan_agreement",
            "identity_document",
            "bank_statement",
            "correspondence",
            "other"
          ]
        },
        {
          "name": "status",
          "type": "varchar",
          "semantic": {
            "control": "Select",
            "enum_values": [
              "queued",
              "ocr_processing",
              "ai_extracting",
              "complete",
              "failed"
            ]
          },
          "enum_values": [
            "queued",
            "ocr_processing",
            "ai_extracting",
            "complete",
            "failed"
          ]
        },
        {
          "name": "ocrText",
          "type": "text",
          "hidden_from_roles": [
            "archivist"
          ]
        },
        {
          "name": "ocrTextTsv",
          "type": "text"
        },
        {
          "name": "ocrConfidence",
          "type": "integer"
        },
        {
          "name": "pageCount",
          "type": "integer"
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/documents.ts",
      "used_by": [
        "ExtractedField"
      ],
      "depends_on": [
        "Batch",
        "Org"
      ]
    },
    "ExtractedField": {
      "table": "extracted_fields",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "documentId",
          "type": "uuid"
        },
        {
          "name": "key",
          "type": "varchar"
        },
        {
          "name": "value",
          "type": "text"
        },
        {
          "name": "valueTsv",
          "type": "text"
        },
        {
          "name": "confidence",
          "type": "integer"
        },
        {
          "name": "pageNumber",
          "type": "integer"
        },
        {
          "name": "boundingBox",
          "type": "jsonb",
          "hidden_from_roles": [
            "compliance"
          ]
        },
        {
          "name": "source",
          "type": "varchar",
          "semantic": {
            "control": "Select",
            "enum_values": [
              "ocr",
              "ai_extract"
            ]
          },
          "enum_values": [
            "ocr",
            "ai_extract"
          ]
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/extracted_fields.ts",
      "internal": false,
      "depends_on": [
        "Document"
      ]
    },
    "RetentionPolicy": {
      "table": "retention_policies",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true
        },
        {
          "name": "orgId",
          "type": "uuid"
        },
        {
          "name": "docType",
          "type": "varchar"
        },
        {
          "name": "retainYears",
          "type": "integer"
        },
        {
          "name": "createdAt",
          "type": "timestamp"
        },
        {
          "name": "updatedAt",
          "type": "timestamp"
        }
      ],
      "schema": "src/db/schema/retention_policies.ts",
      "used_by": [],
      "depends_on": [
        "Org"
      ]
    }
  },
  "register": "stripe",
  "authGated": true,
  "relations": [
    {
      "to": "Org",
      "from": "User",
      "foreignKey": "orgId"
    },
    {
      "to": "Org",
      "from": "Batch",
      "foreignKey": "orgId"
    },
    {
      "to": "User",
      "from": "Batch",
      "foreignKey": "uploadedBy"
    },
    {
      "to": "Batch",
      "from": "Document",
      "foreignKey": "batchId"
    },
    {
      "to": "Org",
      "from": "Document",
      "foreignKey": "orgId"
    },
    {
      "to": "Document",
      "from": "ExtractedField",
      "foreignKey": "documentId"
    },
    {
      "to": "Org",
      "from": "RetentionPolicy",
      "foreignKey": "orgId"
    }
  ],
  "workflows": [
    {
      "name": "CreateBatchWorkflow",
      "steps": [
        {
          "id": "create_batch",
          "next": "fan_out_documents",
          "type": "action",
          "config": {
            "table": "batches",
            "fields": [
              "orgId",
              "uploadedBy",
              "notes",
              "status",
              "documentCount"
            ],
            "actionType": "db_insert"
          }
        },
        {
          "id": "fan_out_documents",
          "next": "trigger_ingest_jobs",
          "type": "action",
          "config": {
            "note": "Insert one Document row per uploaded file with status=queued; iterate over files array",
            "table": "documents",
            "fields": [
              "batchId",
              "orgId",
              "originalFilename",
              "filePath",
              "mimeType",
              "sizeBytes",
              "status"
            ],
            "actionType": "db_insert"
          }
        },
        {
          "id": "trigger_ingest_jobs",
          "next": "notify_upload_complete",
          "type": "action",
          "config": {
            "url": "{{env.JOB_QUEUE_URL}}/enqueue",
            "body": {
              "batchId": "{{create_batch.id}}",
              "workflow": "IngestDocumentWorkflow"
            },
            "note": "Enqueue one IngestDocumentWorkflow job per document",
            "method": "POST",
            "actionType": "http_call"
          }
        },
        {
          "id": "notify_upload_complete",
          "next": "end",
          "type": "action",
          "config": {
            "message": "Batch {{create_batch.id}} uploaded successfully. Processing started for {{fan_out_documents.count}} documents.",
            "actionType": "send_notification",
            "recipientRole": "archivist"
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "inputs": [
        {
          "name": "notes",
          "type": "text",
          "source": {
            "kind": "form_field",
            "field": "notes"
          },
          "required": false
        },
        {
          "name": "files",
          "type": "jsonb",
          "source": {
            "kind": "form_field",
            "field": "files"
          },
          "required": true
        },
        {
          "name": "uploadedBy",
          "type": "uuid",
          "source": {
            "kind": "auth",
            "claim": "user.id"
          },
          "required": true
        },
        {
          "name": "orgId",
          "type": "uuid",
          "source": {
            "kind": "auth",
            "claim": "user.orgId"
          },
          "required": true
        }
      ],
      "source": {
        "kind": "form",
        "page": "BatchUploadPage"
      },
      "trigger": "form_submit on BatchUploadPage"
    },
    {
      "name": "IngestDocumentWorkflow",
      "steps": [
        {
          "id": "mark_ocr_processing",
          "next": "call_paddleocr",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "ocr_processing"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "call_paddleocr",
          "next": "update_document_ocr",
          "type": "action",
          "config": {
            "url": "{{env.PADDLEOCR_SIDECAR_URL}}/ocr",
            "body": {
              "file_path": "{{document.filePath}}"
            },
            "note": "Returns {text, confidence, page_count, regions:[{text,bbox,confidence,page}]}",
            "method": "POST",
            "actionType": "http_call"
          }
        },
        {
          "id": "update_document_ocr",
          "next": "ai_classify_doc",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "ocrText",
              "ocrConfidence",
              "pageCount",
              "status"
            ],
            "values": {
              "status": "ai_extracting"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "ai_classify_doc",
          "next": "update_doc_type",
          "type": "action",
          "config": {
            "input": "{{call_paddleocr.text}}",
            "prompt": "Classify the following bank document text into one of: loan_agreement, identity_document, bank_statement, correspondence, other.",
            "actionType": "ai_classify",
            "outputField": "docType"
          }
        },
        {
          "id": "update_doc_type",
          "next": "ai_extract_fields",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "docType"
            ],
            "actionType": "db_update"
          }
        },
        {
          "id": "ai_extract_fields",
          "next": "persist_extracted_fields",
          "type": "action",
          "config": {
            "input": "{{call_paddleocr.text}}",
            "prompt": "Extract all key-value fields from this bank document. Return a JSON array of {key, value, page_number, confidence}.",
            "actionType": "ai_extract",
            "outputField": "extractedFields"
          }
        },
        {
          "id": "persist_extracted_fields",
          "next": "confidence_gate",
          "type": "action",
          "config": {
            "note": "Insert one row per extracted field; source=ai_extract. Append-only \u2014 no UPDATE/DELETE ever issued on this table.",
            "table": "extracted_fields",
            "fields": [
              "documentId",
              "key",
              "value",
              "confidence",
              "pageNumber",
              "boundingBox",
              "source"
            ],
            "actionType": "db_insert"
          }
        },
        {
          "id": "confidence_gate",
          "type": "exclusive_gateway",
          "config": {
            "condition": "call_paddleocr.confidence < 50"
          },
          "branches": {
            "true": "mark_complete_low_confidence",
            "false": "mark_complete"
          }
        },
        {
          "id": "mark_complete_low_confidence",
          "next": "notify_low_confidence",
          "type": "action",
          "config": {
            "note": "Low confidence \u2014 status still complete; UI surfaces amber/red confidence chip for human review",
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "complete"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "notify_low_confidence",
          "next": "rollup_batch_status",
          "type": "action",
          "config": {
            "message": "Document {{documentId}} processed with low OCR confidence ({{call_paddleocr.confidence}}%). Manual review recommended.",
            "actionType": "send_notification",
            "recipientRole": "compliance"
          }
        },
        {
          "id": "mark_complete",
          "next": "rollup_batch_status",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "complete"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "rollup_batch_status",
          "next": "end",
          "type": "action",
          "config": {
            "note": "SELECT FOR UPDATE on batch row; compute status from all child document statuses: all complete\u2192complete, any failed\u2192failed_partial, any queued/processing\u2192processing",
            "table": "batches",
            "where": {
              "id": "{{batchId}}"
            },
            "fields": [
              "status"
            ],
            "actionType": "db_update"
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "inputs": [
        {
          "name": "documentId",
          "type": "uuid",
          "source": {
            "kind": "form_field",
            "field": "documentId"
          },
          "required": true
        },
        {
          "name": "batchId",
          "type": "uuid",
          "source": {
            "kind": "form_field",
            "field": "batchId"
          },
          "required": true
        }
      ],
      "source": {
        "kind": "event",
        "event": "job_queue.IngestDocument"
      },
      "trigger": "api_event"
    },
    {
      "name": "IngestDocumentFailureWorkflow",
      "steps": [
        {
          "id": "mark_failed",
          "next": "rollup_on_failure",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "failed"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "rollup_on_failure",
          "next": "notify_failure",
          "type": "action",
          "config": {
            "note": "SELECT FOR UPDATE; recompute from child statuses",
            "table": "batches",
            "where": {
              "id": "{{batchId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "failed_partial"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "notify_failure",
          "next": "end",
          "type": "action",
          "config": {
            "message": "Document {{documentId}} failed to process. Error: {{errorMessage}}. Use 'Retry Failed' on the batch detail page.",
            "actionType": "send_notification",
            "recipientRole": "archivist"
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "inputs": [
        {
          "name": "documentId",
          "type": "uuid",
          "source": {
            "kind": "form_field",
            "field": "documentId"
          },
          "required": true
        },
        {
          "name": "batchId",
          "type": "uuid",
          "source": {
            "kind": "form_field",
            "field": "batchId"
          },
          "required": true
        },
        {
          "name": "errorMessage",
          "type": "text",
          "source": {
            "kind": "form_field",
            "field": "errorMessage"
          },
          "required": false
        }
      ],
      "source": {
        "kind": "event",
        "event": "job_queue.IngestDocument.failed"
      },
      "trigger": "api_event"
    },
    {
      "name": "RetryFailedDocumentsWorkflow",
      "steps": [
        {
          "id": "query_failed_docs",
          "next": "reset_doc_status",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "status": "failed",
              "batchId": "{{batchId}}"
            },
            "actionType": "db_query",
            "outputField": "failedDocs"
          }
        },
        {
          "id": "reset_doc_status",
          "next": "reset_batch_status",
          "type": "action",
          "config": {
            "table": "documents",
            "where": {
              "status": "failed",
              "batchId": "{{batchId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "queued"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "reset_batch_status",
          "next": "enqueue_retry_jobs",
          "type": "action",
          "config": {
            "table": "batches",
            "where": {
              "id": "{{batchId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "queued"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "enqueue_retry_jobs",
          "next": "end",
          "type": "action",
          "config": {
            "url": "{{env.JOB_QUEUE_URL}}/enqueue",
            "body": {
              "workflow": "IngestDocumentWorkflow",
              "documents": "{{query_failed_docs.failedDocs}}"
            },
            "method": "POST",
            "actionType": "http_call"
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "inputs": [
        {
          "name": "batchId",
          "type": "uuid",
          "source": {
            "kind": "route",
            "param": "id"
          },
          "required": true
        }
      ],
      "source": {
        "kind": "button",
        "page": "BatchDetailPage"
      },
      "trigger": "button on BatchDetailPage"
    },
    {
      "name": "FlagDocumentWorkflow",
      "steps": [
        {
          "id": "update_doc_flagged",
          "next": "notify_compliance",
          "type": "action",
          "config": {
            "note": "Re-uses failed status as flagged-for-review; v2 can add a dedicated flagged status",
            "table": "documents",
            "where": {
              "id": "{{documentId}}"
            },
            "fields": [
              "status"
            ],
            "values": {
              "status": "failed"
            },
            "actionType": "db_update"
          }
        },
        {
          "id": "notify_compliance",
          "next": "end",
          "type": "action",
          "config": {
            "message": "Document {{documentId}} has been flagged for manual review by user {{reviewerId}}.",
            "actionType": "send_notification",
            "recipientRole": "compliance"
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "inputs": [
        {
          "name": "documentId",
          "type": "uuid",
          "source": {
            "kind": "route",
            "param": "id"
          },
          "required": true
        },
        {
          "name": "reviewerId",
          "type": "uuid",
          "source": {
            "kind": "auth",
            "claim": "user.id"
          },
          "required": true
        }
      ],
      "source": {
        "kind": "button",
        "page": "DocumentViewerPage"
      },
      "trigger": "button on DocumentViewerPage"
    }
  ],
  "api_routes": [
    {
      "path": "/api/batches",
      "method": "POST",
      "workflow": "CreateBatchWorkflow",
      "description": "Create batch and fan out document records; enqueue ingest jobs"
    },
    {
      "path": "/api/batches",
      "method": "GET",
      "description": "List batches for org, ordered by createdAt desc"
    },
    {
      "path": "/api/batches/:id",
      "method": "GET",
      "description": "Batch detail with nested documents"
    },
    {
      "path": "/api/documents/:id",
      "method": "GET",
      "description": "Document detail with extracted fields and ocr text"
    },
    {
      "path": "/api/search",
      "method": "GET",
      "description": "Full-text search over documents and extracted fields using tsvector; params: q, docType, dateFrom, dateTo, minConfidence, page, limit"
    },
    {
      "path": "/api/documents/:id/retry",
      "method": "POST",
      "workflow": "RetryFailedDocumentsWorkflow",
      "description": "Re-enqueue a single failed document for ingest"
    },
    {
      "path": "/api/batches/:id/retry",
      "method": "POST",
      "workflow": "RetryFailedDocumentsWorkflow",
      "description": "Retry all failed documents in a batch"
    },
    {
      "path": "/api/documents/:id/flag",
      "method": "POST",
      "workflow": "FlagDocumentWorkflow",
      "description": "Flag document for manual compliance review"
    },
    {
      "path": "/api/retention-policies",
      "method": "GET",
      "description": "List retention policies for org"
    },
    {
      "path": "/api/retention-policies",
      "method": "POST",
      "description": "Create retention policy"
    },
    {
      "path": "/api/retention-policies/:id",
      "method": "PUT",
      "description": "Update retention policy"
    }
  ],
  "assumptions": [
    "PaddleOCR runs as an HTTP REST sidecar service; the IngestDocument workflow calls it via http_call \u2014 resolved: simplest integration for on-prem Docker Compose deployment.",
    "File storage uses MinIO (S3-compatible); Document.file_path stores the object key, not bytea \u2014 resolved: avoids Postgres bloat.",
    "Auth is local accounts (email+password) in v1 with an LDAP seam comment in User entity \u2014 resolved: LDAP integration deferred.",
    "Batch status rollup uses SELECT FOR UPDATE advisory lock inside the RollupBatchStatus workflow triggered after each Document settles \u2014 resolved: prevents race conditions.",
    "ExtractedField is enforced append-only at the application layer via workflow design (no update/delete steps) and documented as a DB-level trigger requirement \u2014 resolved: compliance requirement.",
    "Retention policy enforcement (cron purge) is out of scope for v1; RetentionPolicy entity schema is present to make v2 addition easy \u2014 resolved.",
    "PDF viewer uses pdf.js fallback in the UI for CSP-restricted environments \u2014 resolved: noted in document viewer page description.",
    "tsvector full-text search joins Document.ocr_text_tsv and ExtractedField.value_tsv with ts_rank weighting to avoid duplicate hits \u2014 resolved: single SQL query with deduplication.",
    "Polling on the batch history page uses setTimeout-recurse pattern, stops when all batches are settled \u2014 resolved: prevents re-entrancy."
  ],
