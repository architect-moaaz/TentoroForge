        },
        {
          "type": "chart",
          "entity": "Document",
          "title": "Avg OCR Confidence by Type",
          "groupBy": "docType"
        },
        {
          "type": "stat",
          "entity": "Document",
          "title": "Failed Documents",
          "metric": {
            "fn": "count"
          }
        }
      ],
      "features": [],
      "archetype": "report",
      "description": "Charts: documents processed per day (line), breakdown by docType (pie), average OCR confidence by docType (bar), failed vs complete ratio. Date range filter.",
      "entity_summary": [
        "Org",
        "User",
        "Batch",
        "Document",
        "ExtractedField",
        "RetentionPolicy"
      ]
    },
    {
      "name": "Login",
      "type": "auth",
      "route": "/login",
      "entity": null,
      "actions": [],
      "features": [],
      "archetype": "list"
    },
