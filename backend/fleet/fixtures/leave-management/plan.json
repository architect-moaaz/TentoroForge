          "user_fk_role": "assignment",
          "role": "assignment",
          "fk": {
            "table": "users",
            "column": "id"
          }
        },
        {
          "name": "leaveType",
          "type": "varchar",
          "not_null": true,
          "enum_values": [
            "Vacation",
            "Sick",
            "Personal",
            "Parental",
            "Unpaid"
          ],
          "semantic": {
            "control": "Select",
            "enum_values": [
              "Vacation",
              "Sick",
              "Personal",
              "Parental",
              "Unpaid"
            ]
          }
        },
        {
          "name": "startDate",
          "type": "timestamp",
          "not_null": true
        },
        {
          "name": "endDate",
          "type": "timestamp",
          "not_null": true
        },
        {
          "name": "reason",
          "type": "text",
          "not_null": false
        },
        {
          "name": "status",
          "type": "varchar",
          "not_null": true,
          "enum_values": [
            "pending",
            "approved",
            "rejected"
          ],
          "semantic": {
            "control": "Select",
            "enum_values": [
              "pending",
