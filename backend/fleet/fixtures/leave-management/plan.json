              "rejected"
            ]
          }
        },
        {
          "name": "reviewerNote",
          "type": "text",
          "not_null": false
        },
        {
          "name": "createdAt",
          "type": "timestamp",
          "not_null": true
        },
        {
          "name": "updatedAt",
          "type": "timestamp",
          "not_null": true
        }
      ],
      "indexes": []
    }
  ],
  "authGated": true,
  "assumptions": [
    "Employees can only submit requests; managers can approve or reject.",
    "reviewerNote is optional on approve/reject \u2014 managers may leave it blank.",
    "Status values are pending, approved, rejected \u2014 no draft or cancelled state assumed.",
    "No multi-level approval chain \u2014 one manager approval is sufficient.",
    "Notifications are in-app; email delivery is not modelled at this stage.",
    "Employee and Reviewer synthesized entities removed \u2014 User entity with role enum covers both actor types.",
    "Login page archetype changed to form (not list) since it has no dataSource.",
    "EmployeeList and ManagerList pages filter User entity by role; both declare actions[]."
  ]
}
