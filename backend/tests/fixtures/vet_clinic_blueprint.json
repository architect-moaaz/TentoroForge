  "pages": [],
  "businessRules": [
    {
      "id": "RULE-001",
      "name": "One vet, one slot",
      "statement": "A veterinarian cannot have two scheduled appointments at the same date and time.",
      "appliesTo": [
        "ENTITY-005",
        "FLOW-001"
      ],
      "kind": "statement",
      "scope": "server",
      "requirements": [],
      "confidence": 0.9,
      "status": "PROPOSED"
    }
  ],
  "security": {
    "ownershipRules": [
      {
        "entity": "Veterinarian",
        "column": "accountId",
        "kind": "scope",
        "scope": "user",
        "unscopedRoles": [
          "Admin",
          "Receptionist"
        ],
        "reads": "scoped",
        "note": "A vet sees and changes only their own row; the front desk sees every vet."
      },
      {
        "entity": "Prescription",
        "column": "prescribingVeterinarianId",
        "kind": "scope",
        "scope": "user",
        "unscopedRoles": [
          "Admin"
        ],
        "reads": "scoped",
        "note": "A vet reaches only the prescriptions they wrote."
      },
      {
        "entity": "Invoice",
        "column": "ownerId",
        "kind": "scope",
        "scope": "user",
        "unscopedRoles": [
          "Admin",
          "Receptionist"
        ],
        "reads": "scoped",
        "note": "Money records stay with the front desk."
      },
      {
        "entity": "Appointment",
        "column": "veterinarianId",
        "kind": "attribution",
        "scope": "user",
        "unscopedRoles": [],
        "reads": "scoped",
        "note": "Records which vet an appointment is with; filters nothing."
      }
    ]
  },
  "workflows": [
    {
      "id": "FLOW-001",
      "name": "Book Appointment",
      "purpose": "Staff books an appointment for a pet with a veterinarian at a date and time.",
      "trigger": {
        "kind": "manual",
        "detail": "Staff press Save Appointment."
      },
      "launchedFrom": [],
      "status": "PROPOSED",
      "inputs": [
        {
          "name": "pet",
          "kind": "record",
          "entity": "ENTITY-003",
          "required": true
        },
        {
          "name": "owner",
          "kind": "record",
          "entity": "ENTITY-002",
          "required": true
        },
        {
          "name": "veterinarian",
          "kind": "record",
          "entity": "ENTITY-004",
          "required": true
        },
        {
          "name": "date",
          "kind": "field",
          "type": "date",
          "required": true
        },
        {
          "name": "time",
          "kind": "field",
          "type": "string",
          "required": true
        },
        {
          "name": "durationMinutes",
          "kind": "field",
          "type": "integer",
          "required": true
        },
        {
          "name": "reason",
          "kind": "field",
          "type": "text",
          "required": true
        }
      ],
      "steps": [
        {
          "key": "start",
          "name": "Start",
          "type": "trigger",
          "config": {
            "type": "manual"
          },
          "next": [
            "find_conflicts"
          ]
        },
        {
          "key": "find_conflicts",
          "name": "Find Overlapping Appointments",
          "type": "action",
          "config": {
            "actionType": "db_query",
            "table": "appointments",
            "where": {
              "date": "{{date}}",
              "status": "Scheduled",
              "time": "{{time}}",
              "veterinarianId": "{{veterinarian.id}}"
            }
          },
          "next": [
            "check_conflict"
          ]
        },
        {
          "key": "check_conflict",
          "name": "Is Slot Already Booked?",
          "type": "condition",
          "config": {
            "expression": "count(find_conflicts.output) > 0"
          },
          "next": [
            "refuse_booking",
            "insert_appointment"
          ]
        },
        {
          "key": "refuse_booking",
          "name": "Refuse: Slot Unavailable",
          "type": "end",
          "config": {
            "refused": true,
            "message": "This veterinarian already has an appointment at that time. Choose another slot."
          },
          "next": []
        },
        {
          "key": "insert_appointment",
          "name": "Create Appointment",
          "type": "action",
          "config": {
            "actionType": "db_insert",
            "table": "appointments",
            "values": {
              "ownerId": "{{owner.id}}",
              "petId": "{{pet.id}}",
              "veterinarianId": "{{veterinarian.id}}",
              "date": "{{date}}",
              "time": "{{time}}",
              "durationMinutes": "{{durationMinutes}}",
              "reason": "{{reason}}",
              "status": "Scheduled"
            }
          },
          "next": [
            "booked"
          ]
        },
        {
          "key": "booked",
          "name": "Booked",
          "type": "end",
          "config": {
            "refused": false
          },
          "next": []
        }
      ]
    },
    {
      "id": "FLOW-002",
      "name": "Cancel Appointment",
      "purpose": "Staff cancels a scheduled appointment.",
      "trigger": {
        "kind": "manual"
      },
      "launchedFrom": [],
      "status": "PROPOSED",
      "inputs": [
        {
          "name": "appointment",
          "kind": "record",
          "entity": "ENTITY-005",
          "required": true
        }
      ],
      "steps": [
        {
          "key": "start",
          "name": "Start",
          "type": "trigger",
          "config": {
            "type": "manual"
          },
          "next": [
            "cancel"
          ]
        },
        {
          "key": "cancel",
          "name": "Mark Cancelled",
          "type": "action",
          "config": {
            "actionType": "db_update",
            "table": "appointments",
            "values": {
              "status": "Cancelled"
            },
            "where": {
              "id": "{{appointment.id}}"
            }
          },
          "next": [
            "done"
          ]
        },
        {
          "key": "done",
          "name": "Done",
          "type": "end",
          "config": {
            "refused": false
          },
          "next": []
        }
      ]
    },
    {
      "id": "FLOW-003",
      "name": "Delete Prescription",
      "purpose": "A vet removes a prescription entered by mistake.",
      "trigger": {
        "kind": "manual"
      },
      "launchedFrom": [],
      "status": "PROPOSED",
      "inputs": [
        {
          "name": "prescription",
          "kind": "record",
          "entity": "ENTITY-008",
          "required": true
        }
      ],
      "steps": [
        {
          "key": "start",
          "name": "Start",
          "type": "trigger",
          "config": {
            "type": "manual"
          },
          "next": [
            "remove"
          ]
        },
        {
          "key": "remove",
          "name": "Remove",
          "type": "action",
          "config": {
            "actionType": "db_delete",
            "table": "prescriptions",
            "where": {
              "id": "{{prescription.id}}"
            }
          },
          "next": [
            "done"
          ]
        },
        {
          "key": "done",
          "name": "Done",
          "type": "end",
          "config": {
            "refused": false
          },
          "next": []
        }
      ]
    },
    {
      "id": "FLOW-004",
      "name": "Refund Invoice",
      "purpose": "Staff refunds a paid invoice.",
      "trigger": {
        "kind": "manual"
      },
      "launchedFrom": [],
      "status": "PROPOSED",
      "inputs": [
        {
          "name": "invoice",
          "kind": "record",
          "entity": "ENTITY-009",
          "required": true
        }
      ],
      "steps": [
        {
          "key": "start",
          "name": "Start",
          "type": "trigger",
          "config": {
