{
  "schemaVersion": "1",
  "id": "products/form",
  "route": "/products/new",
  "layout": "DashboardLayout",
  "meta": { "title": "New Product" },
  "dataSources": [],
  "root": {
    "id": "page-root",
    "type": "Stack",
    "props": { "direction": "vertical", "gap": "spacing.6" },
    "children": [
      {
        "id": "breadcrumb",
        "type": "Breadcrumb",
        "props": {
          "items": [
            { "label": "Products", "href": "/products" },
            { "label": "New Product" }
          ]
        }
      },
      {
        "id": "form-heading",
        "type": "Heading",
        "props": { "level": 1, "content": "New Product" }
      },
      {
        "id": "form-card",
        "type": "Card",
        "props": {},
        "children": [
          {
            "id": "product-form",
            "type": "Form",
            "props": {
              "workflow": "createProduct",
              "submitLabel": "Save Product",
              "fields": [
                {
                  "kind": "text",
                  "name": "name",
                  "label": "Name",
                  "required": true,
                  "placeholder": "Widget"
                },
                {
                  "kind": "textarea",
                  "name": "description",
                  "label": "Description",
                  "rows": 3
                },
                {
                  "kind": "number",
                  "name": "price",
                  "label": "Price",
                  "required": true,
                  "placeholder": "0.00"
                },
                {
                  "kind": "select",
                  "name": "category",
                  "label": "Category",
                  "options": [
                    { "value": "electronics", "label": "Electronics" },
                    { "value": "apparel", "label": "Apparel" },
                    { "value": "home", "label": "Home & Garden" },
                    { "value": "sports", "label": "Sports" },
                    { "value": "other", "label": "Other" }
                  ]
                },
                {
                  "kind": "checkbox",
                  "name": "in_stock",
                  "label": "In stock"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "form-actions",
        "type": "Row",
        "props": { "justify": "end", "gap": "spacing.3" },
        "children": [
          {
            "id": "cancel-btn",
            "type": "Button",
            "props": {
              "label": "Cancel",
              "variant": "secondary",
              "navigate": "/products"
            }
          }
        ]
      }
    ]
  }
}
