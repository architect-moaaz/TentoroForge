{
  "designRationale": "Warm, trustworthy, accessible. Soft greens + generous whitespace.",
  "colorPalette": {
    "primary":      "#15803d",
    "secondary":    "#0ea5e9",
    "accent":       "#f59e0b",
    "background":   "#fefffe",
    "surface":      "#f0fdf4",
    "surfaceHover": "#dcfce7",
    "border":       "#bbf7d0",
    "muted":        "#86efac",
    "textPrimary":  "#14532d",
    "textSecondary":"#166534",
    "textTertiary": "#15803d",
    "sidebarBg":    "#14532d",
    "sidebarText":  "#bbf7d0",
    "sidebarActiveItem": "#166534",
    "success":      "#22c55e",
    "warning":      "#f59e0b",
    "error":        "#ef4444",
    "info":         "#0ea5e9"
  },
  "typography": {
    "fontFamily":     "DM Sans, system-ui, sans-serif",
    "headingWeight":  "600",
    "lineHeight":     "1.6",
    "letterSpacing":  "normal",
    "scale": {
      "h1":      "2rem",
      "h2":      "1.5rem",
      "h3":      "1.25rem",
      "body":    "1rem",
      "caption": "0.875rem"
    }
  },
  "spacing": {
    "scale":         "4px base: 4/8/16/24",
    "pagePadding":   "px-6 py-8",
    "cardPadding":   "p-6",
    "sectionGap":    "gap-10",
    "elementGap":    "gap-6",
    "inputGap":      "gap-4"
  },
  "borderRadius": {
    "sm":   "0.5rem",
    "md":   "0.75rem",
    "lg":   "1rem",
    "xl":   "1.5rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 3px rgba(20,83,45,0.06)",
    "md": "0 4px 14px rgba(20,83,45,0.10)",
    "lg": "0 10px 30px rgba(20,83,45,0.12)",
    "xl": "0 20px 50px rgba(20,83,45,0.14)"
  },
  "animation": {
    "duration": "200ms for micro, 400ms for transitions",
    "easing":   "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "imagery": {
    "loginBackground":  "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1920",
    "dashboardHero":    "https://images.unsplash.com/photo-1559757148-5c350d0d3c56?w=1920",
    "emptyStateStyle":  "flat",
    "iconStyle":        "outline",
    "avatarStyle":      "initials"
  },
  "statusColors": {
    "Active":   { "color": "green",  "label": "Active" },
    "Critical": { "color": "red",    "label": "Critical" },
    "Stable":   { "color": "blue",   "label": "Stable" }
  },
  "layout": {
    "navigation": "sidebar",
    "density":    "spacious"
  }
}
