ANTHROPIC_API_KEY=your-anthropic-api-key-here
DATABASE_URL=postgresql+asyncpg://appforge:appforge@localhost:5432/appforge
SECRET_KEY=change-this-in-production

# ─── Last-24h feature set — everything enabled by default ────────────────────
# Turn any single flag OFF by setting it to "0". The block below is grouped by
# spec so it's easy to disable a whole surface if something misbehaves.

# --- Spec A: brief-canonical design pipeline ---
# BRIEF_AUTHOR runs the brief-authoring phase (produces contracts/brief.json).
# BRIEF_CONSUME lets downstream agents read the brief in their prompts.
# BRIEF_CANONICAL swaps the design phase from the LLM agent to the deterministic
# brief→design_spec mapper. All three must be on for the full canonical path.
# Emergency rollback: FORGE_LEGACY_DESIGN_AGENT=1 forces the LLM design agent
# back even when a brief is present.
FORGE_BRIEF_AUTHOR=1
FORGE_BRIEF_CONSUME=1
FORGE_BRIEF_CANONICAL=1

# --- Spec B: form polish ---
# FORM_CONTEXT_PANEL — side-rail on create/edit forms (Slice 4).
# FIELD_VISIBILITY   — conditional sections in forms (Slice 6).
# INPUT_MAP_BACKFILL is default-on inside the code; no need to set it here.
FORGE_FORM_CONTEXT_PANEL=1
FORGE_FIELD_VISIBILITY=1

# --- Spec C: post-gen polish (one flag per slice) ---
FORGE_POLISH_DASHBOARD=1          # Slice 1 — dashboard composition compiler
FORGE_POLISH_SIGNATURE_MOVES=1    # Slice 2 — brand signature-move apply pass
FORGE_POLISH_INTERACTIONS=1       # Slice 4 — interactions CSS inject
FORGE_POLISH_DARK_MODE=1          # Slice 4/8 — dark-mode CSS inject
FORGE_POLISH_EDGE_PAGES=1         # Slice 5 — 404/403/500/loading/maintenance
FORGE_POLISH_VARIETY=1            # Slice 6 — library catalog into planner prompt
FORGE_POLISH_MOTION=1             # Slice 8 — motion tokens writer
FORGE_POLISH_LOGO=1               # Slice 9 — deterministic monogram logo

# --- Spec D: authorship consolidation ---
# CLEANUP_WAVE_4 extends the brief-author prompt with the new authored fields
# (visual_stance, auth_taglines, product_name_candidates). Needed for Wave 4
# brief content to appear.
FORGE_CLEANUP_WAVE_4=1

# Wave 5 LLM classifiers for Figma layer→action / layer→component / label→icon.
# INERT until a caller populates services.figma_llm_ctx.set_figma_llm_context()
# with a non-empty registry — pipeline behavior is unchanged for callers that
# don't opt in. Set to 0 to disable eligibility entirely.
FORGE_FIGMA_LLM=1

# --- Spec E: advanced UX ---
# E_INTERACTIONS enables Wave 1 planner-intent + post-gen wiring for
# Table.reorderable / selectionMode / bulkActions and Kanban.moveBetweenLanes.
# Also emits /api/data/:entity/reorder and /api/presence/:route templates
# when the plan calls for them.
FORGE_E_INTERACTIONS=1
# E_PATTERNS enables Wave 3 post-gen passes for Wizard / FilterBuilder /
# TourOverlay + planner emission blocks for page.wizard, editable_columns,
# layout=master_detail, filter_fields, journey.onboarding.
FORGE_E_PATTERNS=1
# A11Y_GATE runs accessibility_audit.run_axe_audit inside self_verify_pass.
# When STRICT is also on, failures block the verify gate.
FORGE_A11Y_GATE=1
FORGE_A11Y_GATE_STRICT=0
# POLISH_HIGH_CONTRAST injects the [data-theme="high-contrast"] palette
# variant + wires it into ThemeToggle.
FORGE_POLISH_HIGH_CONTRAST=1

# --- Blueprint (source-of-truth per-app doc) ---
# BLUEPRINT regenerates BLUEPRINT.md on every mutation seam (generation +
# editor + Smith edits). Feeds Smith's system prompt as authoritative
# reference. Set to 0 to skip regeneration and injection.
FORGE_BLUEPRINT=1
