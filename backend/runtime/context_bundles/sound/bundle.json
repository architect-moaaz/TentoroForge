{
  "capability": "sound",
  "permissions": {
    "ios": {
      "NSMicrophoneUsageDescription": "We use audio playback and short sound cues."
    },
    "android": [
      "android.permission.MODIFY_AUDIO_SETTINGS"
    ],
    "expo_plugins": ["expo-av"]
  },
  "native_imports": {
    "expo": ["expo-av"],
    "web": []
  },
  "provider": {
    "template_path": "providers/SoundProvider.tsx.tmpl",
    "wrap_at": "root",
    "hook_names": ["useSoundEffect", "useAudioPlayer"]
  },
  "integration_keys": []
}
