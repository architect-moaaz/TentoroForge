{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chain-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "generated/chain-app",
      "autoPort": true
    },
    {
      "name": "forge-api",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "6577"
      ],
      "cwd": "backend",
      "port": 6577,
      "autoPort": true
    }
  ]
}
